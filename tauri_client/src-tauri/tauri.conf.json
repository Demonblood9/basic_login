{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "SecureLicense",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "updater": {
        "active": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.securelicense.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": true,
      "endpoints": [
        "http://localhost:5000/api/tauri-update/{{target}}/{{current_version}}"
      ],
      "dialog": false,
      "pubkey": ""
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": false,
        "title": "Secure License Client",
        "width": 500,
        "height": 650,
        "center": true,
        "decorations": true
      }
    ]
  }
}
